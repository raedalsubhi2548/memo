{
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/merchant.xml",
      "destination": "/api/rebuild?op=feed"
    },
    {
      "source": "/(cart|checkout|login|account|admin)",
      "destination": "/200"
    },
    {
      "source": "/(order|review|account|admin)/:path*",
      "destination": "/200"
    }
  ],
  "headers": [
    {
      "source": "/.well-known/apple-developer-merchantid-domain-association",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/plain; charset=utf-8"
        },
        {
          "key": "Content-Disposition",
          "value": "inline"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'sha256-jlkVcrOSn4aan5p/Wf9P2RYWEul/u0tCfT6jGBPLSss=' https://challenges.cloudflare.com https://www.googletagmanager.com https://sc-static.net https://tr.snapchat.com https://tap-sdks.b-cdn.net https://applepay.cdn-apple.com; style-src 'self' 'unsafe-inline' https://tap-sdks.b-cdn.net https://tap-assets.b-cdn.net; font-src 'self' https://tap-sdks.b-cdn.net https://tap-assets.b-cdn.net; img-src 'self' data: blob: https:; connect-src 'self' https://*.supabase.co wss://*.supabase.co https://challenges.cloudflare.com https://www.googletagmanager.com https://*.google-analytics.com https://*.analytics.google.com https://tr.snapchat.com https://*.snapchat.com https://*.tap.company https://tap-sdks.b-cdn.net https://tap-assets.b-cdn.net; frame-src 'self' https://challenges.cloudflare.com https://tr.snapchat.com https://*.tap.company; frame-ancestors 'self'; base-uri 'self'; form-action 'self' https://*.tap.company; object-src 'none'; upgrade-insecure-requests"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=(self)"
        },
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/brand/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=2592000"
        }
      ]
    },
    {
      "source": "/brand/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=2592000, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/(logo.png|logo-white.png|og.jpg|favicon.png|apple-touch-icon.png|icon-512.png)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/admin(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "admin\\..*"
        }
      ],
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    }
  ],
  "functions": {
    "api/*.js": {
      "includeFiles": "api/_assets/**"
    }
  },
  "redirects": [
    {
      "source": "/c/:slug",
      "destination": "/:slug",
      "permanent": true
    },
    {
      "source": "/p/:slug",
      "destination": "/:slug",
      "permanent": true
    }
  ]
}
