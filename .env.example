# Names only. Real values go in Vercel → Project → Settings → Environment Variables (never in git).
# Leave the two Supabase values empty to run in demo mode (data saved in the browser).

# --- store ---
VITE_SITE_URL=            # https://<the store domain>  (admin.<domain> opens the dashboard)
SITE_URL=                 # same as VITE_SITE_URL (server side: emails, payment return links)
STORE_EMAIL=              # optional: shown in emails and invoices

# --- Supabase (Project Settings → API) ---
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- payments: Tap (merchant account in the store owner's name) ---
TAP_SECRET_KEY=
VITE_TAP_PUBLIC_KEY=      # optional: card fields inside the checkout (key registered for the store domain)
VITE_TAP_MERCHANT_ID=     # optional: Apple Pay inside the checkout

# --- email (store mailbox, SMTP) ---
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
ORDER_NOTIFY_TO=          # where the owner's order copies go

# --- rebuild after catalog/design changes (Vercel → Settings → Git → Deploy Hooks) ---
VERCEL_DEPLOY_HOOK=

# --- optional marketing ---
VITE_GA_ID=               # G-XXXXXXX
VITE_SNAP_PIXEL=          # Snap pixel id
VITE_TURNSTILE_SITE_KEY=  # Cloudflare Turnstile site key (secret goes in Supabase → Auth → Attack Protection)

# OTO shipping (tryoto.com «أوتو API» → ربط القناة → رمز التحديث). Secret.
OTO_REFRESH_TOKEN=
# optional: the pickup location code from OTO
OTO_PICKUP_CODE=
